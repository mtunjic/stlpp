          "name": "ninja-debug"
        },
        {
          "type": "build",
          "name": "ninja-debug"
        },
        {
          "type": "test",
          "name": "ninja-debug"
        }
      ]
    },
    {
      "name": "ninja-release",
      "displayName": "Configure, build, and test Release with Ninja",
      "steps": [
        {
          "type": "configure",
          "name": "ninja-release"
        },
        {
          "type": "build",
          "name": "ninja-release"
        },
        {
          "type": "test",
          "name": "ninja-release"
        }
