      "displayName": "Configure, build, and test Debug with Visual Studio",
      "steps": [
        {
          "type": "configure",
          "name": "debug"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "release",
      "displayName": "Configure, build, and test Release with Visual Studio",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Configure, build, and test RelWithDebInfo with Visual Studio",
      "steps": [
        {
          "type": "configure",
          "name": "relwithdebinfo"
        },
        {
          "type": "build",
          "name": "relwithdebinfo"
        },
        {
          "type": "test",
          "name": "relwithdebinfo"
        }
      ]
    },
    {
      "name": "sanitize",
      "displayName": "Configure, build, and test with Visual Studio AddressSanitizer",
      "steps": [
        {
          "type": "configure",
          "name": "sanitize"
        },
        {
          "type": "build",
          "name": "sanitize"
        },
        {
          "type": "test",
          "name": "sanitize"
        }
      ]
    },
    {
      "name": "ninja-debug",
      "displayName": "Configure, build, and test Debug with Ninja",
      "steps": [
        {
